    {
      "id": "gpp",
      "title": "Общая физическая подготовка",
      "template": "gpp-level",
      "items": [
        {
          "id": "prep",
          "title": "Подготовительный уровень",
          "groups": [
            {
              "id": "pulling",
              "label": "Тянущие",
              "exercises": [
                {
                  "id": "pull-hang",
                  "title": "Вис в упоре на перекладине",
                  "description": "Исходное положение: руки на ширине плеч, хват сверху, ноги вместе. Удерживайте вис 15–30 секунд под контролем тренера.",
                  "goal": "Укрепить хват, мышцы спины и плечевого пояса, подготовить ребёнка к подтягиваниям.",
                  "principle": "Лопатки опущены и сведены, корпус напряжён, дыхание ровное, без раскачивания.",
                  "errors": "Полное «провисание» в плечах, сгибание в пояснице, задержка дыхания, рывковый соскок с перекладины.",
                  "subSections": []
                },
                {
                  "id": "pull-australian",
                  "title": "Австралийские подтягивания",
                  "description": "Горизонтальная тяга к перекладине: корпус прямой, стопы на полу, грудь тянется к грифу в плавном темпе.",
                  "goal": "Развить тянущие мышцы спины и рук в безопасной амплитуде без полного виса.",
                  "principle": "Локти движутся вдоль корпуса, в верхней точке сводим лопатки, опускаемся без рывка.",
                  "errors": "Прогиб в пояснице, неполная амплитуда, отрыв таза от линии корпуса, работа только руками без спины.",
                  "subSections": []
                }
              ]
            },
            {
              "id": "pushing",
              "label": "Толкающие",
              "exercises": [
                {
                  "id": "push-bench",
                  "title": "Отжимания от скамьи",
                  "description": "Руки на устойчивой опоре (скамья, параллеты), корпус прямой. Сгибание и разгибание рук в груди, 8–12 повторений.",
                  "goal": "Укрепить грудные, передние дельты и трицепс — база для отжиманий от пола и стойки.",
                  "principle": "Корпус — одна линия, локти под углом ~45°, не опускать таз и не выгибать поясницу.",
                  "errors": "Провисание таза, локти расходятся в стороны, короткая амплитуда, удар головой вперёд.",
                  "subSections": []
                },
                {
                  "id": "push-knee",
                  "title": "Отжимания с колен",
                  "description": "Классическое отжимание с опорой на колени. Ладони на ширине плеч, опускание до лёгкого касания грудью пола.",
                  "goal": "Освоить толкающий паттерн с меньшей нагрузкой, чем в полном отжимании.",
                  "principle": "Корпус от колен до головы прямой, движение вниз и вверх синхронно, без «ломания» в пояснице.",
                  "errors": "Ягодицы выше линии плеч, локти врозь, отсутствие контроля в нижней точке.",
                  "subSections": []
                }
              ]
            },
            {
              "id": "core",
              "label": "Мышцы кора",
              "exercises": [
                {
                  "id": "core-plank",
                  "title": "Планка на предплечьях",
                  "description": "Опора на предплечья и носки, тело в одной линии. Удержание 20–40 секунд.",
                  "goal": "Развить стабильность кора — основа для статики, динамики и безопасной осанки.",
                  "principle": "Напрячь пресс и ягодицы, не поднимать и не опускать таз, смотреть в пол перед собой.",
                  "errors": "Прогиб или «домик» в пояснице, опущенная голова, задержка дыхания, смещение веса на одну сторону.",
                  "subSections": []
                },
                {
                  "id": "core-deadbug",
                  "title": "«Мёртвый жук»",
                  "description": "Лёжа на спине, руки вверх, колени согнуты 90°. Поочерёдное выпрямление противоположной руки и ноги без отрыва поясницы от пола.",
                  "goal": "Научить контролировать поясницу при движении конечностей — важно для всех элементов воркаута.",
                  "principle": "Поясница прижата к полу, движения медленные, выдох на усилии, возврат в исходное положение под контролем.",
                  "errors": "Отрыв поясницы, быстрые рывки, полное выпрямление ноги с прогибом в спине.",
                  "subSections": []
                }
              ]
            }
          ],
          "contentBlocks": [],
          "subSections": []
        },
